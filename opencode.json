{
    "$schema": "https://opencode.ai/config.json",
    "permission": "allow",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--browser-url",
                "http://127.0.0.1:9222"
            ]
        }
    }
}